# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/iem_admission

PORT=5000

# First Administrator account, created on first start if no admin exists
ADMIN_EMAIL=admin@iem.test
ADMIN_PASSWORD=ChangeMe@123

# Address of the React client, used in password-reset links
CLIENT_URL=http://localhost:5173

# Sandbox email: fraction of notifications that fail (0 to 1), for testing FR-14
SANDBOX_EMAIL_FAIL_RATE=0
